{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "outDir": ".test-dist",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": [
    "src/core/**/*.ts",
    "src/ui/circuit-layers.ts",
    "src/ui/note-render.ts",
    "src/ui/bom-panel.ts",
    "src/ui/schematic-panel.ts",
    "src/ui/floating-properties.ts",
    "src/ui/resistor-value-fields.ts",
    "src/model.ts"
  ]
}
